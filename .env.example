# Copy to .env.local for `vercel dev`, and set the same keys in
# Vercel → Project → Settings → Environment Variables for deployments.
# None of these are exposed to the browser: they are read only inside
# /api/book.js, which runs server-side.

# --- Google Sheets ---------------------------------------------------------
# From the service account JSON key file (see README → Booking form).
GOOGLE_SERVICE_ACCOUNT_EMAIL=xxx@yyy.iam.gserviceaccount.com
# Paste the whole PEM including the BEGIN/END lines. Newlines may be escaped
# as \n — the code handles either form.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# The id from the sheet URL:
# docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=1sZNngru7ZnWZlUerBcxEwdkOpl_WJDdJkofq6EIg5Jo
# Tab name, as shown on the tab itself. Defaults to Sheet1.
GOOGLE_SHEET_NAME=Sheet1

# --- Email alerts (optional) ----------------------------------------------
# Leave RESEND_API_KEY unset to skip alerts; bookings still reach the sheet.
RESEND_API_KEY=re_xxx
# Must be on a domain verified in Resend.
BOOKING_ALERT_FROM=site@mohormedia.com
# Comma-separate for several recipients.
BOOKING_ALERT_TO=hello@mohormedia.com

# --- Content studio (server only) -----------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27020
MONGODB_DB=mohormedia_local
APP_ORIGIN=http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
ADMIN_JWT_SECRET=replace-with-at-least-32-random-characters
