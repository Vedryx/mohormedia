{
  "rewrites": [
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/contact/",
      "destination": "/contact.html"
    },
    {
      "source": "/((?!api/|assets/|contact\\.html|contact/?$|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
